generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id String @id @default(uuid())

  name String

  email String @unique

  password String

  role UserRole @default(USER)

  profile Profile?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Profile {
  id String @id @default(uuid())

  headline String?

  experienceYears Int?

  location String?

  targetSalary Int?

  resumeUrl String?

  skills String[]

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Opportunity {
  id String @id @default(uuid())

  title String

  company String

  description String

  type OpportunityType

  requiredSkills String[]

  experienceRequired Int?

  location String?

  salaryMin Int?

  salaryMax Int?

  sourceUrl String?

  deadline DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum OpportunityType {
  JOB
  INTERNSHIP
  HACKATHON
  SCHOLARSHIP
}
